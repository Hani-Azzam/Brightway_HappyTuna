# ============================================================================
# HappyTuna simulation — the single, global .env for the whole project.
# Copy to `.env` (untracked) and fill in the keys. Every service gets this
# file via `env_file: .env` in docker-compose.yml; docker-internal URLs are
# NOT set here — the compose file wires those per service.
# ============================================================================

# ---------------------------------------------------------------- LLM keys --
# NVIDIA NIM (https://build.nvidia.com) — customer agent, influencer agent,
# and the event generator's LLM mode. All run meta/llama-3.1-8b-instruct.
NVIDIA_API_KEY=

# Google Gemini — journalist agent and CEO agent (gemini-2.5-flash-lite),
# plus the journalist's knowledge-base embeddings.
GEMINI_API_KEY=

# Anthropic — employee agents (claude-haiku-4-5) and, optionally, the social
# network's AI sentiment analysis.
ANTHROPIC_API_KEY=

# Alternative for the influencer agent instead of NIM: set NAT_CONFIG_FILE to
# configs/config.openai.yml on its service and fill this in.
OPENAI_API_KEY=

# ------------------------------------------------- NIM outage escape hatch --
# The customer and influencer agents are the two that run on NVIDIA NIM. When
# build.nvidia.com's chat endpoint is degraded (symptom: every call hangs ~300s
# and dies with `HTTP 504 ... Nvcf-Status: errored`, while GET /v1/models still
# answers instantly), point them at any OpenAI-compatible endpoint instead. The
# values below run both on Gemini using GEMINI_API_KEY -- uncomment, then
# `docker compose up -d --no-deps customer-agent influencer-agent` (--no-deps so
# rebuilding the agents doesn't recreate the social network and clear the feed).
#
#   CUSTOMER_LLM_ENGINE=openai
#   CUSTOMER_LLM_MODEL=gemini-2.5-flash-lite
#   CUSTOMER_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   CUSTOMER_LLM_API_KEY=<same value as GEMINI_API_KEY>
#   NAT_CONFIG_FILE=configs/config.gemini.yml

# ------------------------------------------------------------ social network --
# The tuna company under study. Not hardcoded anywhere; everything derives
# from this.
COMPANY_NAME=HappyTuna
COMPANY_ALIASES=
PLATFORM_NAME=BrightTweets
CORS_ORIGIN=*
# Load the demo crisis arc (example users + a scripted burst of posts) at boot.
# Left false so the simulation starts from an empty feed and everything you see
# was written by the agents. The social network keeps no volume, so the feed is
# also wiped every time the container is recreated -- see docker-compose.yml.
SEED_DB=false
# Optional: Claude-based sentiment analysis in the analytics service (uses
# ANTHROPIC_API_KEY). Off = deterministic lexicon scorer, zero LLM cost.
AI_ANALYSIS_ENABLED=false

# ------------------------------------------------------------------ journalist --
JOURNALIST_MODEL=gemini-2.5-flash-lite
JOURNALIST_TEMPERATURE=0.2
JOURNALIST_MAX_STEPS=12

# ------------------------------------------------------------------------ CEO --
GEMINI_MODEL_NAME=gemini-2.5-flash-lite
# Hold back every gateway write (public posts, ticket patches, chat) while
# still executing reads. Flip to true to observe without acting.
CEO_DRY_RUN=false
# Seconds between the CEO's periodic "review the world" cycles (0 disables;
# press events still trigger cycles). Each cycle spends LLM tokens.
CEO_REVIEW_INTERVAL=900
# Seconds to batch a burst of press events into one CEO cycle.
CEO_EVENT_DEBOUNCE=20

# ------------------------------------------------------------------ employees --
# Employees share ANTHROPIC_API_KEY above; uncomment to give them their own key.
# EMPLOYEE_ANTHROPIC_API_KEY=
# Model override, e.g. a bigger Claude for harder runs.
EMPLOYEE_ANTHROPIC_MODEL=claude-haiku-4-5
# Seconds between customer-support queue sweeps (0 disables). A sweep wakes at
# most one employee, and only when open tickets exist.
EMPLOYEE_SUPPORT_SWEEP_INTERVAL=180
